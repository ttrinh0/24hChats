@model ChatModel

<button id="chat-settings-btn" type="submit" class="btn align-self-end rounded-4" data-bs-toggle="modal"
        data-bs-target="#chatSettingsModal">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-gear-fill"
         viewBox="0 0 16 16">
        <path
        d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z" />
    </svg>
</button>

<div class="modal fade" id="chatSettingsModal" role="dialog">
    <div class="modal-dialog modal-dialog-centered my-0" role="document">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Chatroom Settings</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <div>
                        <label asp-for="RoomName" class="form-label">Chatroom Name</label>
                        <input asp-for="RoomName" type="name" class="form-control" value="@Model.Room.Name"
                               placeholder="Enter Chatroom Name">
                    </div>
                    <div class="my-2">
                        <label asp-for="RoomDesc" class="form-label">Chatroom Description</label>
                        <input asp-for="RoomDesc" type="name" class="form-control" value="@Model.Room.Description"
                               placeholder="Enter Chatroom Description">
                    </div>
                    <div class="my-2">
                        <label for="room-theme" class="form-label">Theme</label>
                        <div class="create-room-theme">
                            <div>
                                <select id="room-theme" class="form-select" disabled aria-describedby="theme-help">
                                    <option>Default</option>
                                </select>
                                <small id="theme-help" class="text-muted">More themes coming soon.</small>
                            </div>
                            <div class="theme-preview" aria-label="Theme preview placeholder">Preview image</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
            <hr />
            <form asp-page-handler="Delete" method="post" class="m-auto mb-3">
                <input asp-for="RoomDesc" type="name" class="form-control" value="@Model.Room.Description" hidden />
                <input asp-for="RoomName" type="name" class="form-control" value="@Model.Room.Name"
                       placeholder="Enter Chatroom Name" hidden />
                <button type="submit" class="btn btn-danger">Delete Room</button>
            </form>
        </div>
    </div>
</div>