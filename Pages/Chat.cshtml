@page "{roomId:guid?}"
@model ChatModel
@{
    @* ViewData["Title"] = Model.Room.Name; *@
}

<section id="chatroom" class="justify-content-center">
    <div id="chat-container" class="mt-3">
        @* left box *@
        <div class="container m-4 my-2 d-flex flex-column">
            <div class="chat-desc-text">
                <div id="chat" data-room-id="@Model.Room.Id" data-expires-at="@Model.Room.ExpiresAt.ToString("O")"
                     class="d-flex justify-content-between mt-2">
                    <input id="userInput" value="@Model.ChatUserId" type="hidden" />
                    <input id="userColour" value="@Model.ChatUserColour" type="hidden" />
                    <h1 class="mb-2">@Model.Room.Name</h1>
                    <li class="align-self-end mb-2 list-unstyled text-muted">Status: <span id="connectionStatus"
                                                                                           role="status">
                        Connecting…
                    </span></li>
                    <p class="align-self-end mb-2">Chat opened until @Model.Room.ExpiresAt.ToString("f")</p>
                </div>
                <hr class="mt-2" />
                <p>@Model.Room.Description</p>
            </div>
            <div id="message-box" class="border d-block bg-white">
                <ul id="messagesList" class="list-unstyled p-4 pb-0 flex-grow-1" aria-live="polite">

                    @foreach (var message in Model.Messages)
                    {
                        <li class="mb-2 chatmessage">
                            <span class="message-nickname message-@message.Colour">@message.User.Nickname</span>
                            <span class="message-time">@message.SentAt.ToLocalTime().ToString("t")</span><br />
                            @message.Message
                        </li>
                    }

                </ul>

            </div>
            <div id="action-bar" class="mt-3 mx-4">
                <form id="messageForm" class="d-flex gap-2">
                    <label for="messageInput" class="visually-hidden">Message</label>
                    <input id="messageInput" role="textbox" class="form-control" maxlength="2000" autocomplete="off"
                           placeholder="Write a message…" />
                    <button id="sendButton" type="submit" class="btn btn-primary" disabled>
                        Send
                    </button>
                </form>
            </div>
        </div>



        @* User box *@
        <aside id="users"
               class="p-3 pb-0 my-2 border-start border-3 overflow-hidden d-flex flex-column justify-content-between chat-desc-text">
            <div>
                <h2 class="text-center mb-3">Users</h2>
                <hr class="my-2 mb-3" />
                @foreach (var member in Model.Room.ChatMembers)
                {
                    if (member.UserId == Model.Room.OwnerId)
                    {
                        <li class="d-flex list-unstyled user-list">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                 class="bi bi-star-fill my-auto me-2" viewBox="0 0 16 16">
                                <path
                                d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                            </svg>
                            @member.ChatUser.Nickname
                        </li>
                    }
                    else
                    {
                        <li class="list-unstyled user-list">@member.ChatUser.Nickname</li>
                    }

                }
            </div>
            @if (Model.ChatUserId == Model.Room.OwnerId)
            {
                <partial name="_ChatSettings" />
            }
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}