@page "{roomId:guid?}"
@model ChatModel
@{
    ViewData["Title"] = Model.Room.Name;
}

<a asp-page="/Index">All rooms</a>

<h1>@Model.Room.Name</h1>
<p>Choose a nickname to chat.</p>

<div id="chat"
     data-room-id="@Model.Room.Id"
     data-expires-at="@Model.Room.ExpiresAt.ToString("O")">

    <p id="connectionStatus" role="status">Connecting…</p>

    <label for="userInput" class="form-label">Nickname</label>
    <input id="userInput"
           class="form-control mb-3"
           maxlength="40"
           placeholder="Your nickname" />

    <ul id="messagesList"
        class="list-unstyled"
        aria-live="polite"></ul>

    <form id="messageForm" class="d-flex gap-2">
        <label for="messageInput" class="visually-hidden">Message</label>
        <input id="messageInput"
               class="form-control"
               maxlength="2000"
               autocomplete="off"
               placeholder="Write a message…" />

        <button id="sendButton"
                type="submit"
                class="btn btn-primary"
                disabled>
            Send
        </button>
    </form>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}