@page
@model MyRoomsModel
@{ ViewData["Title"] = "My Rooms"; }
<div class="room-page">
    <div class="page-title-row"><div><h1>My Rooms</h1><p class="room-page-intro">Rooms you've created that are still open.</p></div></div>
    <section class="room-section" aria-labelledby="my-rooms-heading">
        <div class="room-section-heading"><h2 id="my-rooms-heading">My Rooms</h2></div>
        @if (Model.Rooms.Count == 0) { <p class="room-empty">You haven't created a room yet.</p> }
        else { <div class="room-grid">@foreach (var room in Model.Rooms) { <partial name="_RoomCard" model="room" /> }</div> }
    </section>
</div>
