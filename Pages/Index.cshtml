@page
@model IndexModel
@{
    ViewData["Title"] = "Chat rooms";
}

<h1>Chat rooms</h1>
<p>Start a conversation. Each room lasts 24 hours.</p>

<form method="post" class="mb-4">
    <label asp-for="RoomName" class="form-label">Room name</label>

    <div class="d-flex gap-2">
        <input asp-for="RoomName"
               class="form-control"
               maxlength="80"
               placeholder="What would you like to talk about?" />

        <button type="submit" class="btn btn-primary">
            Create room
        </button>
    </div>

    <span asp-validation-for="RoomName" class="text-danger"></span>
</form>

@if (Model.Rooms.Count == 0)
{
    <p>No active rooms yet. Create the first one!</p>
}
else
{
    <div class="list-group">
        @foreach (var room in Model.Rooms)
        {
            <a asp-page="/Chat"
               asp-route-roomId="@room.Id"
               class="list-group-item list-group-item-action">
                <strong>@room.Name</strong>
                <small class="d-block text-muted">
                    Expires @room.ExpiresAt.ToString("yyyy-MM-dd HH:mm 'UTC'")
                </small>
            </a>
        }
    </div>
}